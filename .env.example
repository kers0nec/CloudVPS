# CloudVPS Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/cloudvps_db.json

# Persistent storage root. On platforms with a single mountable persistent
# volume (Render disks, Fly volumes, etc.) point this at that mount so BOTH
# the account database (data/) and every VPS workspace (vps_instances/) live
# on durable storage. Leaving this unset uses the project directory, which
# is fine for local dev / Docker (see docker-compose.yml volumes) but NOT
# safe on hosts with ephemeral filesystems — accounts and VPS files will be
# wiped on every redeploy or restart if this isn't backed by real storage.
# PERSIST_DIR=/var/data

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production
# The dashboard polls live bot logs every few seconds; keep this generous.
API_RATE_LIMIT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Host node daemon (worker.js) — the dedicated process that hosts and
# supervises every workload 24/7, separate from the web API.
# NODE_WORKER_URL overrides the full URL (e.g. http://worker:3101 when the
# node runs as a separate container/service); otherwise the client uses
# http://127.0.0.1:NODE_WORKER_PORT. The shared auth token lives in
# <PERSIST_DIR>/data/node-worker.token (worker generates it on first boot)
# and can be pinned explicitly with NODE_WORKER_TOKEN.
NODE_WORKER_PORT=3101
# NODE_WORKER_URL=http://127.0.0.1:3101
# NODE_WORKER_TOKEN=
# NODE_WORKER_BIND=127.0.0.1

# Discord Bot (for default bot)
DISCORD_BOT_TOKEN=

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=true