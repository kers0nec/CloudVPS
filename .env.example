# CloudVPS Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/cloudvps_db.json

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production
# The dashboard polls live bot logs every few seconds; keep this generous.
API_RATE_LIMIT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Discord Bot (for default bot)
DISCORD_BOT_TOKEN=

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=true